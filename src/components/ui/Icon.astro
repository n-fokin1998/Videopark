---
/** Decorative line icon for zero-JS components (same set as Icon.svelte). Always `aria-hidden`. */
import { icons, type IconDef, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 24 } = Astro.props;
const icon: IconDef = icons[name];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {icon.paths.map((d) => (
    <path d={d} />
  ))}
</svg>
