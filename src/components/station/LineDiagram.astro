---
/**
 * The line diagram (docs/design.md §5 «Line map»): the red line with every station, its tagline and «вы здесь»,
 * plus grey transfer lines to the stations off the line (Женя, Об архиве). Vertical in narrow containers (phones,
 * the full-screen «Схема» sheet), horizontal when there is room. Zero JS; links carry `data-line-map` so a jump
 * from the map zooms instead of sliding (src/scripts/navigation.ts).
 */
import { localizedPath, useTranslations, type Locale } from '~/i18n';
import { isTerminal, lineStations, stations, type StationId } from '~/lib/stations';

interface Props {
  locale: Locale;
  current?: StationId | undefined;
  /** Accessible name of the list (the surrounding heading's id). */
  labelledBy: string;
}

const { locale, current, labelledBy } = Astro.props;
const t = useTranslations(locale);
const offLine = stations.filter((s) => s.kind !== 'line');
---

<div class="diagram">
  <ol role="list" class="diagram__line" aria-labelledby={labelledBy}>
    {lineStations.map((station) => (
      <li
        class:list={['diagram__stop', { 'is-current': station.id === current, 'is-terminal': isTerminal(station.id) }]}
      >
        <a
          href={localizedPath(station.path, locale)}
          aria-current={station.id === current ? 'page' : undefined}
          data-line-map
        >
          <span class="diagram__dot" aria-hidden="true" />
          <span class="diagram__text">
            <span class="diagram__name">{t(station.nameKey)}</span>
            <span class="diagram__tagline">{t(station.taglineKey)}</span>
            {station.id === current && <span class="diagram__here meta">{t('map.current')}</span>}
          </span>
        </a>
      </li>
    ))}
  </ol>

  <div class="diagram__transfers">
    <p class="meta" id={`${labelledBy}-transfers`}>
      {t('map.transfers')}
    </p>
    <ul role="list" aria-labelledby={`${labelledBy}-transfers`}>
      {offLine.map((station) => (
        <li class:list={['diagram__stop', 'is-transfer', { 'is-current': station.id === current }]}>
          <a
            href={localizedPath(station.path, locale)}
            aria-current={station.id === current ? 'page' : undefined}
            data-line-map
          >
            <span class="diagram__dot" aria-hidden="true" />
            <span class="diagram__text">
              <span class="diagram__name">{t(station.nameKey)}</span>
              <span class="diagram__tagline">{t(station.taglineKey)}</span>
              {station.id === current && <span class="diagram__here meta">{t('map.current')}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  @layer components {
    .diagram {
      --stop-gap: var(--space-2xs);
      --rail: var(--line);

      container: diagram / inline-size;
      display: grid;
      gap: var(--space-l);
    }

    .diagram__line,
    .diagram__transfers ul {
      position: relative;
      display: grid;
      gap: var(--stop-gap);
    }

    /* The red line: one segment from each dot to the next, so it ends exactly at the terminal (vertical by default). */
    .diagram__stop {
      position: relative;
    }

    .diagram__stop:not(:last-child)::before {
      content: '';
      position: absolute;
      inset-block-start: calc(var(--hit-target) / 2);
      inset-inline-start: calc(var(--hit-target) / 2 - var(--line-stroke) / 2);
      inline-size: var(--line-stroke);
      block-size: calc(100% + var(--stop-gap));
      background: var(--rail);
    }

    .diagram__transfers {
      display: grid;
      gap: var(--space-2xs);
    }

    .diagram__transfers ul {
      --rail: var(--border);
    }

    .diagram__stop a {
      position: relative;
      display: grid;
      grid-template-columns: var(--hit-target) minmax(0, 1fr);
      align-items: start;
      gap: var(--space-xs);
      min-block-size: var(--hit-target);
      padding-block: var(--space-3xs);
      color: var(--fg);
      text-decoration: none;
      border-radius: var(--radius-m);
    }

    .diagram__dot {
      justify-self: center;
      inline-size: var(--dot-size);
      block-size: var(--dot-size);
      margin-block-start: calc(var(--hit-target) / 2 - var(--dot-size) / 2 - var(--space-3xs));
      border: var(--line-stroke) solid var(--rail);
      border-radius: var(--radius-round);
      background: var(--bg);
      transition: transform var(--dur-instant) var(--ease-out);
    }

    .is-transfer .diagram__dot {
      border-color: var(--fg-muted);
    }

    .is-terminal .diagram__dot {
      inline-size: calc(var(--dot-size) * 1.6);
      block-size: calc(var(--dot-size) * 1.6);
      margin-block-start: calc(var(--hit-target) / 2 - var(--dot-size) * 0.8 - var(--space-3xs));
    }

    .is-current .diagram__dot {
      background: var(--line);
      box-shadow: 0 0 0 var(--space-3xs) color-mix(in srgb, var(--line) 30%, transparent);
    }

    .diagram__text {
      display: grid;
      gap: var(--space-3xs);
      padding-block: var(--space-2xs);
    }

    .diagram__name {
      font-size: var(--fs-h2);
      font-weight: 600;
      line-height: var(--lh-heading);
    }

    .is-transfer .diagram__name {
      font-size: var(--fs-body);
    }

    .diagram__tagline {
      font-size: var(--fs-ui);
      color: var(--fg-muted);
    }

    .diagram__here {
      color: var(--accent);
    }

    @media (hover: hover) {
      .diagram__stop a:hover .diagram__dot {
        transform: scale(1.3);
      }

      .diagram__stop a:hover .diagram__name {
        color: var(--accent);
      }
    }

    /* Wide: the line runs horizontally, names under the dots; transfers drop below like a branch. */
    @container diagram (width >= 56rem) {
      .diagram__line {
        grid-template-columns: repeat(7, minmax(0, 1fr));
      }

      .diagram__line .diagram__stop:not(:last-child)::before {
        inset-block-start: calc(var(--hit-target) / 2 - var(--line-stroke) / 2);
        inset-inline-start: 50%;
        inline-size: calc(100% + var(--stop-gap));
        block-size: var(--line-stroke);
      }

      .diagram__line .diagram__stop a {
        grid-template-columns: 1fr;
        justify-items: center;
        text-align: center;
        gap: 0;
      }

      .diagram__line .diagram__name {
        font-size: var(--fs-body);
      }

      .diagram__line .diagram__tagline {
        font-size: var(--fs-meta);
      }

      .diagram__transfers ul {
        grid-template-columns: repeat(auto-fit, minmax(14rem, max-content));
        gap: var(--space-l);
      }

      .diagram__transfers .diagram__stop::before {
        display: none;
      }
    }

    @media (forced-colors: active) {
      .diagram__stop::before,
      .is-current .diagram__dot {
        background: CanvasText;
      }
    }
  }
</style>
